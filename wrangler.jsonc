{
  // shouarchive.beakbig.com 을 서비스하는 Worker (정적 파일만). Cloudflare 빌드가 푸시마다 `npx wrangler deploy` 로 올린다.
  // 이 파일이 없으면 빌드가 매번 같은 설정을 자동으로 만든다 — 고정해 두려고 둔다. 뺄 파일은 .assetsignore,
  // 응답 헤더(CSP 등)는 루트 _headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shouarchive",
  "compatibility_date": "2026-10-01",
  "observability": {
    // 요청(invocation) 로그는 끈다 — 방문자 IP · 머리글이 Cloudflare 의 Workers Logs 에 남지 않게 (2026-10-20 결정 D3 · 개인정보 처리방침).
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "assets": {
    "directory": ".",
    // /support → support.html (확장자 없는 주소), /support.html → /support 로 307. 사이트 안 링크는 모두 확장자 없이 쓴다.
    "html_handling": "auto-trailing-slash",
    // 없는 주소에는 루트 404.html 을 404 상태로 돌려준다.
    "not_found_handling": "404-page"
  },
  // sandbox 결제 사이트 (2026-10-30) — shouarchive-sandbox.beakbig.com. tools/deploy-sandbox.py 가 저장소를 임시 폴더에 풀어
  // sandbox 값(Paddle sandbox · 결제 열림 · sandbox 라이선스 서버 license-staging.beakbig.com)으로 다시 만든 뒤
  // `wrangler deploy --env sandbox` 로 올린다. 운영 빌드(deploy 브랜치 · `npx wrangler deploy`)는 이 설정을 쓰지 않는다.
  "env": {
    "sandbox": {
      "name": "shouarchive-sandbox",
      "routes": [
        { "pattern": "shouarchive-sandbox.beakbig.com", "custom_domain": true }
      ],
      "assets": {
        "directory": ".",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
